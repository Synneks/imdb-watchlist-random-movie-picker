{
  "manifest_version": 3,
  "name": "IMDb Watchlist Random Picker",
  "version": "1.1.0",
  "description": "Pick a random movie from an IMDb or Letterboxd list.",
  "permissions": ["storage", "tabs", "scripting", "windows"],
  "host_permissions": ["https://www.imdb.com/*", "https://letterboxd.com/*", "https://www.letterboxd.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
